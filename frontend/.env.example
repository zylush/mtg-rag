# Local development override. Omit in a Firebase Hosting build to use its same-origin API proxy.
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.web.app
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
VITE_PUBLIC_SITE_URL=https://replace-with-public-domain.example
# Keep false for local, development, preview, and unapproved deployments.
VITE_ALLOW_INDEXING=false
