project_id      = "replace-with-prod-project"
environment     = "prod"
region          = "asia-east1"
api_domain      = "api.example.com"
frontend_origin = "https://example.com"
api_image       = "asia-east1-docker.pkg.dev/replace-with-prod-project/mtg-rag-prod/api@sha256:replace-with-64-hex-digest"
# For a schema-changing rollout, pin the new digest here first while api_image stays old.
migration_image = null

# Pin the reviewed Secret Manager versions for this release.
openai_secret_version = "1"
database_url_secret_version = "1"
conversation_context_enabled = false

billing_account_id = "000000-000000-000000"
monthly_budget_usd  = 100

monitoring_notification_channels = [
  "projects/replace-with-prod-project/notificationChannels/replace-with-channel-id",
]

labels = {
  owner = "replace-with-owner"
}
